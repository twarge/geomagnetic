<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Partial Info.plist, merged with the generated one (GENERATE_INFOPLIST_FILE stays YES).
     Registers the geomagnetic:// scheme used by widget deep links. -->
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.twarge.observatory.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>geomagnetic</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
