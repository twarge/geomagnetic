        { "path": "<PRODUCTS>/ObservatoryWatch.app", "id": "000000000000000000000095", "type": "wrapper.application", "index": false, "target-membership": [ { "build-phase": "Observatory/copy/Embed Watch Content", "platforms": [ "ios" ], "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/ObservatoryWatchWidgets.appex", "id": "000000000000000000000097", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "ObservatoryWatch/copy/Embed Foundation Extensions", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
