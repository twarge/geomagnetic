  "targets": [
    {
      "name": "Observatory",
      "id": "0000000000000000000000B8",
      "product": "Products/Geomagnetic.app",
      "product-type": "application",
      "dependencies": [
        "ObservatoryWidgets",
        { "target": "ObservatoryWatch", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "copy",
          "name": "Embed Watch Content",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/Watch",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Resources/App/Observatory.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "6",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Resources/App/Observatory-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Geomagnetic",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright 2026 Twarge LLC.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsMultipleScenes": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*]": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*]": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=xros*]": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=xrsimulator*]": "@executable_path/Frameworks",
        "MARKETING_VERSION": "1.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.observatory",
        "PRODUCT_NAME": "Geomagnetic",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
      },
    }, {
      "name": "ObservatoryWidgets",
      "id": "00000000000000000000009A",
      "product": "Products/ObservatoryWidgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Resources/Widgets/ObservatoryWidgets.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "6",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Resources/Widgets/ObservatoryWidgets-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Geomagnetic",
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphoneos*]": [
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=iphonesimulator*]": [
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xros*]": [
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=xrsimulator*]": [
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "1.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.observatory.widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
      },
    }, {
      "name": "ObservatoryWatch",
      "id": "00000000000000000000009C",
      "product": "Products/ObservatoryWatch.app",
      "product-type": "application",
      "dependencies": [
        "ObservatoryWatchWidgets",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Resources/Watch/ObservatoryWatch.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "6",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_CFBundleDisplayName": "Geomagnetic",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright 2026 Twarge LLC.",
        "INFOPLIST_KEY_WKApplication": "YES",
        "INFOPLIST_KEY_WKCompanionAppBundleIdentifier": "com.twarge.observatory",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "1.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.observatory.watch",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "watchos watchsimulator",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "4",
      },
    }, {
      "name": "ObservatoryWatchWidgets",
      "id": "00000000000000000000009E",
      "product": "Products/ObservatoryWatchWidgets.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Resources/WatchWidgets/ObservatoryWatchWidgets.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "6",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_FILE": "Resources/WatchWidgets/ObservatoryWatchWidgets-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Geomagnetic",
        "LD_RUNPATH_SEARCH_PATHS": [
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "1.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.observatory.watch.widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "watchos",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "watchos watchsimulator",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "4",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
